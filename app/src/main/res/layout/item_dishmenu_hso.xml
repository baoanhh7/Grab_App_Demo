<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="5dp"
    android:padding="8dp">

    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ImageView_item_dishmenuHSO"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/burger" />

    <LinearLayout
        android:layout_gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_name_item_dishmenuHSO"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cơm Tấm Ốp La"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_price_item_dishmenuHSO"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="40.000đ"
            android:textSize="16sp" />
    </LinearLayout>

    <Switch
        android:id="@+id/switchToggle_dishmenuHSO"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_height="wrap_content" />
</LinearLayout>
